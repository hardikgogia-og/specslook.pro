{
  "version": 2,
  "trailingSlash": true,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "data/**,public/data/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization, x-github-token, x-github-repo" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)\\.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=1800, stale-while-revalidate=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/merchant-feed",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=1800, stale-while-revalidate=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/home/", "destination": "/", "permanent": true },
    { "source": "/eyeglasses", "destination": "/product-category/eyeglasses/", "permanent": true },
    { "source": "/eyeglasses/", "destination": "/product-category/eyeglasses/", "permanent": true },
    { "source": "/eyewear", "destination": "/product-category/eyeglasses/", "permanent": true },
    { "source": "/eyewear/", "destination": "/product-category/eyeglasses/", "permanent": true },
    { "source": "/specs", "destination": "/product-category/eyeglasses/", "permanent": true },
    { "source": "/specs/", "destination": "/product-category/eyeglasses/", "permanent": true },
    { "source": "/sunglasses", "destination": "/product-category/sunglasses/", "permanent": true },
    { "source": "/sunglasses/", "destination": "/product-category/sunglasses/", "permanent": true },
    { "source": "/shades", "destination": "/product-category/sunglasses/", "permanent": true },
    { "source": "/shades/", "destination": "/product-category/sunglasses/", "permanent": true },
    { "source": "/attachments", "destination": "/product-category/attachments/", "permanent": true },
    { "source": "/attachments/", "destination": "/product-category/attachments/", "permanent": true },
    { "source": "/polarized", "destination": "/product-category/polarized/", "permanent": true },
    { "source": "/polarized/", "destination": "/product-category/polarized/", "permanent": true },
    { "source": "/about-us", "destination": "/about/", "permanent": true },
    { "source": "/about-us/", "destination": "/about/", "permanent": true },
    { "source": "/stores", "destination": "/store/", "permanent": true },
    { "source": "/stores/", "destination": "/store/", "permanent": true },
    { "source": "/contact", "destination": "/contact-us/", "permanent": true },
    { "source": "/contact/", "destination": "/contact-us/", "permanent": true },
    { "source": "/home-eyetest", "destination": "/home/home-eyetest/", "permanent": true },
    { "source": "/home-eyetest/", "destination": "/home/home-eyetest/", "permanent": true },
    { "source": "/eyetest", "destination": "/home/home-eyetest/", "permanent": true },
    { "source": "/eyetest/", "destination": "/home/home-eyetest/", "permanent": true },
    { "source": "/cart", "destination": "/checkout/", "permanent": true },
    { "source": "/cart/", "destination": "/checkout/", "permanent": true },
    { "source": "/my-account", "destination": "/account/", "permanent": true },
    { "source": "/my-account/", "destination": "/account/", "permanent": true },
    { "source": "/terms", "destination": "/terms-and-conditions/", "permanent": true },
    { "source": "/terms/", "destination": "/terms-and-conditions/", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy/", "permanent": true },
    { "source": "/privacy/", "destination": "/privacy-policy/", "permanent": true },
    { "source": "/product/titanium-aviator-polarized-chromance", "destination": "/product/titanium-aviator-polarized-polarvue/", "permanent": true },
    { "source": "/product/titanium-aviator-polarized-chromance/", "destination": "/product/titanium-aviator-polarized-polarvue/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/merchant-feed.xml", "destination": "/api/merchant-feed" },
    { "source": "/merchant-feed", "destination": "/api/merchant-feed" },
    { "source": "/api/merchant-feed.xml", "destination": "/api/merchant-feed" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/shop/:path*", "destination": "/shop/index.html" },
    { "source": "/shop", "destination": "/shop/index.html" },
    { "source": "/product-category/:path*", "destination": "/product-category/:path*/index.html" },
    { "source": "/product/:slug*", "destination": "/product/:slug*/index.html" },
    { "source": "/about/:path*", "destination": "/about/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/store/:path*", "destination": "/store/index.html" },
    { "source": "/store", "destination": "/store/index.html" },
    { "source": "/franchise/:path*", "destination": "/franchise/index.html" },
    { "source": "/franchise", "destination": "/franchise/index.html" },
    { "source": "/home/home-eyetest/:path*", "destination": "/home/home-eyetest/index.html" },
    { "source": "/home/home-eyetest", "destination": "/home/home-eyetest/index.html" },
    { "source": "/contact-us/:path*", "destination": "/contact-us/index.html" },
    { "source": "/contact-us", "destination": "/contact-us/index.html" },
    { "source": "/blog/:path*", "destination": "/blog/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/checkout/:path*", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/account/:path*", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/tracking/:path*", "destination": "/index.html" },
    { "source": "/tracking", "destination": "/index.html" },
    { "source": "/try-on/:path*", "destination": "/index.html" },
    { "source": "/try-on", "destination": "/index.html" },
    { "source": "/terms-and-conditions/:path*", "destination": "/index.html" },
    { "source": "/terms-and-conditions", "destination": "/index.html" },
    { "source": "/privacy-policy/:path*", "destination": "/index.html" },
    { "source": "/privacy-policy", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ]
}
